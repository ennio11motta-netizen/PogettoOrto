PREFIX orto: <http://orto.example/>

orto:windKmh  <http://www.w3.org/2000/01/rdf-schema#label>
                "vento km/h"@it .

<http://orto.example/plant/1>
        a                     orto:EarlyGrowthStage , orto:Plant , orto:PlantInstance;
        orto:belongsToGarden  <http://orto.example/garden/1>;
        orto:growthStage      "SEMINA";
        orto:hasForecast      <http://orto.example/forecast/47> , <http://orto.example/forecast/48>;
        orto:hasRisk          <http://orto.example/risk/39> , <http://orto.example/risk/40>;
        orto:influencedBy     <http://orto.example/weather/30> , <http://orto.example/weather/29>;
        orto:name             "Pomodoro";
        orto:note             "Vaso1";
        orto:speciesName      "Pomodoro";
        orto:storeGDD         "38.099999999999994"^^<http://www.w3.org/2001/XMLSchema#double> .

<http://orto.example/simulation/1-1782816329881>
        a                           orto:AppliedSimulation , orto:SimulationRun;
        orto:createdAt              "2026-06-30T12:45:29.881872300";
        orto:forGarden              <http://orto.example/garden/1>;
        orto:mode                   "APPLIED";
        orto:simulationHasForecast  <http://orto.example/forecast/47> , <http://orto.example/forecast/48>;
        orto:simulationHasPlant     <http://orto.example/plant/1>;
        orto:simulationHasRisk      <http://orto.example/risk/39> , <http://orto.example/risk/40>;
        orto:simulationHasWeather   <http://orto.example/weather/29> , <http://orto.example/weather/30> .

orto:hasForecast  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:Plant;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:GrowthForecast .

orto:basedOnWeather  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:GrowthForecast;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "basato sul meteo"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:WeatherDay .

orto:SimulationRun  <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione"@it .

orto:note  <http://www.w3.org/2000/01/rdf-schema#label>
                "note"@it .

<http://orto.example/weather/30>
        a                    orto:WeatherDay;
        orto:dateTime        "2026-07-01T12:45:30.467993100";
        orto:generatesRisk   <http://orto.example/risk/40>;
        orto:precipitazione  "0.0"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:tempMax         "34.9"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:tempMin         "24.0"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:umidita         "66.25"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:uvIndex         "8.4"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:windKmh         "24.9"^^<http://www.w3.org/2001/XMLSchema#double> .

orto:PreviewSimulation
        <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione previsionale"@it;
        <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:SimulationRun .

orto:Garden  <http://www.w3.org/2000/01/rdf-schema#label>
                "orto"@it .

<http://orto.example/plant/3>
        a                     orto:PlantInstance , orto:Plant , orto:EarlyGrowthStage;
        orto:belongsToGarden  <http://orto.example/garden/2>;
        orto:growthStage      "SEMINA";
        orto:name             "Pomodoro1";
        orto:note             "";
        orto:speciesName      "Pomodoro";
        orto:storeGDD         "0.0"^^<http://www.w3.org/2001/XMLSchema#double> .

orto:EarlyGrowthStage
        <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:GrowthStage .

<http://orto.example/garden/1>
        a               orto:Garden;
        orto:hasPlant   <http://orto.example/plant/1> , <http://orto.example/plant/2>;
        orto:latitude   "39.1766"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:longitude  "8.9716"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:name       "Orto1" .

orto:speciesName  <http://www.w3.org/2000/01/rdf-schema#label>
                "nome specie"@it .

orto:forGarden  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "per orto"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Garden .

<http://orto.example/weather/29>
        a                    orto:WeatherDay;
        orto:dateTime        "2026-06-30T12:45:30.467993100";
        orto:generatesRisk   <http://orto.example/risk/39>;
        orto:precipitazione  "0.2"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:tempMax         "33.6"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:tempMin         "23.7"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:umidita         "65.58333333333333"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:uvIndex         "8.35"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:windKmh         "13.5"^^<http://www.w3.org/2001/XMLSchema#double> .

orto:hasRisk  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:Plant;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Risk .

orto:mode  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "modalità"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                <http://www.w3.org/2000/01/rdf-schema#Literal> .

orto:createdAt  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "creata il"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                <http://www.w3.org/2000/01/rdf-schema#Literal> .

orto:simulationHasPlant
        <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione ha pianta"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Plant .

orto:daysToMaturity  <http://www.w3.org/2000/01/rdf-schema#label>
                "giorni alla maturazione"@it .

orto:percentCiclo  <http://www.w3.org/2000/01/rdf-schema#label>
                "percentuale ciclo"@it .

orto:AdvancedGrowthStage
        <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:GrowthStage .

orto:latitude  <http://www.w3.org/2000/01/rdf-schema#label>
                "latitudine"@it .

orto:simulationHasWeather
        <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione ha meteo"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:WeatherDay .

orto:gddDaily  <http://www.w3.org/2000/01/rdf-schema#label>
                "GDD giornaliero"@it .

orto:AppliedSimulation
        <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione applicata"@it;
        <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:SimulationRun .

orto:name  <http://www.w3.org/2000/01/rdf-schema#label>
                "nome"@it .

orto:generatesRisk  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:WeatherDay;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Risk .

<http://orto.example/risk/40>
        a                  orto:ModerateRisk , orto:Risk , orto:RiskAssessment;
        orto:consigli      "Rischio caldo medio: monitorare idratazione e temperatura.";
        orto:riskCaldo     "MEDIUM";
        orto:riskFreddo    "LOW";
        orto:riskMalattia  "LOW";
        orto:riskVento     "LOW" .

<http://orto.example/forecast/48>
        a                    orto:GrowthForecast;
        orto:basedOnWeather  <http://orto.example/weather/30>;
        orto:dateTime        "2026-06-30T12:45:30.544919400";
        orto:daysToMaturity  "40"^^<http://www.w3.org/2001/XMLSchema#int>;
        orto:gddDaily        "19.45"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:growthStage     "SEMINA";
        orto:percentCiclo    "4.762499999999999"^^<http://www.w3.org/2001/XMLSchema#double> .

orto:hasPlant  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:Garden;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "ha pianta"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Plant .

orto:CriticalRisk  <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:Risk .

