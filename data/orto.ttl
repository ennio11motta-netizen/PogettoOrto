PREFIX orto: <http://orto.example/>

orto:windKmh  <http://www.w3.org/2000/01/rdf-schema#label>
                "vento km/h"@it .

<http://orto.example/plant/1>
        a                     orto:EarlyGrowthStage , orto:Plant , orto:PlantInstance;
        orto:belongsToGarden  <http://orto.example/garden/1>;
        orto:growthStage      "SEMINA";
        orto:name             "Pomodoro";
        orto:note             "Vaso1";
        orto:speciesName      "Pomodoro";
        orto:storeGDD         "0.0"^^<http://www.w3.org/2001/XMLSchema#double> .

orto:hasForecast  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:Plant;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:GrowthForecast .

orto:basedOnWeather  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:GrowthForecast;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "basato sul meteo"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:WeatherDay .

orto:SimulationRun  <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione"@it .

orto:note  <http://www.w3.org/2000/01/rdf-schema#label>
                "note"@it .

orto:PreviewSimulation
        <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione previsionale"@it;
        <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:SimulationRun .

orto:Garden  <http://www.w3.org/2000/01/rdf-schema#label>
                "orto"@it .

<http://orto.example/plant/3>
        a                     orto:EarlyGrowthStage , orto:Plant , orto:PlantInstance;
        orto:belongsToGarden  <http://orto.example/garden/2>;
        orto:growthStage      "SEMINA";
        orto:name             "Pomodoro1";
        orto:note             "";
        orto:speciesName      "Pomodoro";
        orto:storeGDD         "0.0"^^<http://www.w3.org/2001/XMLSchema#double> .

orto:EarlyGrowthStage
        <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:GrowthStage .

<http://orto.example/garden/1>
        a               orto:Garden;
        orto:hasPlant   <http://orto.example/plant/2> , <http://orto.example/plant/1>;
        orto:latitude   "39.1766"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:longitude  "8.9716"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:name       "Orto1" .

orto:speciesName  <http://www.w3.org/2000/01/rdf-schema#label>
                "nome specie"@it .

orto:forGarden  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "per orto"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Garden .

orto:hasRisk  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:Plant;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Risk .

orto:mode  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "modalità"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                <http://www.w3.org/2000/01/rdf-schema#Literal> .

orto:createdAt  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "creata il"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                <http://www.w3.org/2000/01/rdf-schema#Literal> .

orto:simulationHasPlant
        <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione ha pianta"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Plant .

orto:daysToMaturity  <http://www.w3.org/2000/01/rdf-schema#label>
                "giorni alla maturazione"@it .

orto:percentCiclo  <http://www.w3.org/2000/01/rdf-schema#label>
                "percentuale ciclo"@it .

orto:AdvancedGrowthStage
        <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:GrowthStage .

orto:latitude  <http://www.w3.org/2000/01/rdf-schema#label>
                "latitudine"@it .

orto:simulationHasWeather
        <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione ha meteo"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:WeatherDay .

orto:gddDaily  <http://www.w3.org/2000/01/rdf-schema#label>
                "GDD giornaliero"@it .

orto:AppliedSimulation
        <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione applicata"@it;
        <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:SimulationRun .

orto:name  <http://www.w3.org/2000/01/rdf-schema#label>
                "nome"@it .

orto:generatesRisk  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:WeatherDay;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Risk .

orto:hasPlant  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:Garden;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "ha pianta"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Plant .

orto:CriticalRisk  <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:Risk .

<http://orto.example/plant/2>
        a                     orto:EarlyGrowthStage , orto:Plant , orto:PlantInstance;
        orto:belongsToGarden  <http://orto.example/garden/1>;
        orto:growthStage      "SEMINA";
        orto:name             "Pomodoro";
        orto:note             "Test RDF";
        orto:speciesName      "Pomodoro";
        orto:storeGDD         "35.4"^^<http://www.w3.org/2001/XMLSchema#double> .

orto:simulationHasForecast
        <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione ha previsione crescita"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:GrowthForecast .

<http://orto.example/plant/4>
        a                     orto:EarlyGrowthStage , orto:Plant , orto:PlantInstance;
        orto:belongsToGarden  <http://orto.example/garden/2>;
        orto:growthStage      "SEMINA";
        orto:name             "Pomodoro2";
        orto:note             "";
        orto:speciesName      "Pomodoro";
        orto:storeGDD         "0.0"^^<http://www.w3.org/2001/XMLSchema#double> .

<http://orto.example/garden/2>
        a               orto:Garden;
        orto:hasPlant   <http://orto.example/plant/3> , <http://orto.example/plant/4>;
        orto:latitude   "39.1766"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:longitude  "8.9716"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:name       "Orto1" .

orto:LowRisk  <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:Risk .

orto:simulationHasRisk
        <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione ha rischio"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Risk .

orto:belongsToGarden  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:Plant;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "appartiene all'orto"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Garden .

orto:longitude  <http://www.w3.org/2000/01/rdf-schema#label>
                "longitudine"@it .

orto:influencedBy  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:Plant;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:WeatherDay .

orto:uvIndex  <http://www.w3.org/2000/01/rdf-schema#label>
                "indice UV"@it .

orto:ModerateRisk  <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:Risk .

orto:dateTime  <http://www.w3.org/2000/01/rdf-schema#label>
                "data e ora"@it .
