PREFIX orto: <http://orto.example/>

orto:windKmh  <http://www.w3.org/2000/01/rdf-schema#label>
                "vento km/h"@it .

<http://orto.example/plant/1>
        a                     orto:EarlyGrowthStage , orto:Plant , orto:PlantInstance;
        orto:belongsToGarden  <http://orto.example/garden/1>;
        orto:growthStage      "SEMINA";
        orto:hasForecast      <http://orto.example/forecast/28> , <http://orto.example/forecast/27>;
        orto:hasRisk          <http://orto.example/risk/26> , <http://orto.example/risk/25>;
        orto:influencedBy     <http://orto.example/weather/17> , <http://orto.example/weather/18>;
        orto:isInDanger       true;
        orto:name             "Pomodoro";
        orto:note             "Vaso1";
        orto:speciesName      "Pomodoro";
        orto:storeGDD         "37.75"^^<http://www.w3.org/2001/XMLSchema#double> .

orto:hasForecast  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:Plant;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:GrowthForecast .

orto:basedOnWeather  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:GrowthForecast;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "basato sul meteo"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:WeatherDay .

orto:SimulationRun  <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione"@it .

orto:note  <http://www.w3.org/2000/01/rdf-schema#label>
                "note"@it .

<http://orto.example/risk/25>
        a                  orto:ModerateRisk , orto:Risk , orto:RiskAssessment;
        orto:consigli      "Rischio caldo medio: monitorare idratazione e temperatura.";
        orto:riskCaldo     "MEDIUM";
        orto:riskFreddo    "LOW";
        orto:riskMalattia  "LOW";
        orto:riskVento     "LOW" .

orto:PreviewSimulation
        <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione previsionale"@it;
        <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:SimulationRun .

orto:Garden  <http://www.w3.org/2000/01/rdf-schema#label>
                "orto"@it .

<http://orto.example/plant/3>
        a                     orto:EarlyGrowthStage , orto:Plant , orto:PlantInstance;
        orto:belongsToGarden  <http://orto.example/garden/2>;
        orto:growthStage      "SEMINA";
        orto:name             "Pomodoro1";
        orto:note             "";
        orto:speciesName      "Pomodoro";
        orto:storeGDD         "0.0"^^<http://www.w3.org/2001/XMLSchema#double> .

<http://orto.example/forecast/28>
        a                    orto:GrowthForecast;
        orto:basedOnWeather  <http://orto.example/weather/18>;
        orto:dateTime        "2026-06-28T12:15:30.720424700";
        orto:daysToMaturity  "39"^^<http://www.w3.org/2001/XMLSchema#int>;
        orto:gddDaily        "19.6"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:growthStage     "SEMINA";
        orto:percentCiclo    "4.71875"^^<http://www.w3.org/2001/XMLSchema#double> .

orto:EarlyGrowthStage
        <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:GrowthStage .

<http://orto.example/garden/1>
        a               orto:Garden;
        orto:hasPlant   <http://orto.example/plant/2> , <http://orto.example/plant/1>;
        orto:latitude   "39.1766"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:longitude  "8.9716"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:name       "Orto1" .

orto:speciesName  <http://www.w3.org/2000/01/rdf-schema#label>
                "nome specie"@it .

orto:forGarden  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "per orto"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Garden .

orto:hasRisk  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:Plant;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Risk .

orto:mode  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "modalità"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                <http://www.w3.org/2000/01/rdf-schema#Literal> .

orto:createdAt  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "creata il"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                <http://www.w3.org/2000/01/rdf-schema#Literal> .

orto:simulationHasPlant
        <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione ha pianta"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Plant .

orto:daysToMaturity  <http://www.w3.org/2000/01/rdf-schema#label>
                "giorni alla maturazione"@it .

orto:percentCiclo  <http://www.w3.org/2000/01/rdf-schema#label>
                "percentuale ciclo"@it .

orto:AdvancedGrowthStage
        <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:GrowthStage .

orto:latitude  <http://www.w3.org/2000/01/rdf-schema#label>
                "latitudine"@it .

orto:simulationHasWeather
        <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione ha meteo"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:WeatherDay .

orto:gddDaily  <http://www.w3.org/2000/01/rdf-schema#label>
                "GDD giornaliero"@it .

<http://orto.example/weather/18>
        a                    orto:WeatherDay;
        orto:dateTime        "2026-06-29T12:15:30.658425";
        orto:generatesRisk   <http://orto.example/risk/26>;
        orto:precipitazione  "0.0"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:tempMax         "36.1"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:tempMin         "23.1"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:umidita         "54.25"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:uvIndex         "8.3"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:windKmh         "19.2"^^<http://www.w3.org/2001/XMLSchema#double> .

orto:AppliedSimulation
        <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione applicata"@it;
        <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:SimulationRun .

orto:name  <http://www.w3.org/2000/01/rdf-schema#label>
                "nome"@it .

orto:generatesRisk  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:WeatherDay;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Risk .

orto:hasPlant  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:Garden;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "ha pianta"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Plant .

orto:CriticalRisk  <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:Risk .

<http://orto.example/plant/2>
        a                     orto:EarlyGrowthStage , orto:Plant , orto:PlantInstance;
        orto:belongsToGarden  <http://orto.example/garden/1>;
        orto:growthStage      "SEMINA";
        orto:name             "Pomodoro";
        orto:note             "Test RDF";
        orto:speciesName      "Pomodoro";
        orto:storeGDD         "35.4"^^<http://www.w3.org/2001/XMLSchema#double> .

<http://orto.example/forecast/27>
        a                    orto:GrowthForecast;
        orto:basedOnWeather  <http://orto.example/weather/17>;
        orto:dateTime        "2026-06-28T12:15:30.685426";
        orto:daysToMaturity  "44"^^<http://www.w3.org/2001/XMLSchema#int>;
        orto:gddDaily        "18.15"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:growthStage     "SEMINA";
        orto:percentCiclo    "2.26875"^^<http://www.w3.org/2001/XMLSchema#double> .

orto:simulationHasForecast
        <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione ha previsione crescita"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:GrowthForecast .

<http://orto.example/simulation/1-1782641730351>
        a                           orto:SimulationRun , orto:AppliedSimulation;
        orto:createdAt              "2026-06-28T12:15:30.353261300";
        orto:forGarden              <http://orto.example/garden/1>;
        orto:mode                   "APPLIED";
        orto:simulationHasForecast  <http://orto.example/forecast/28> , <http://orto.example/forecast/27>;
        orto:simulationHasPlant     <http://orto.example/plant/1>;
        orto:simulationHasRisk      <http://orto.example/risk/26> , <http://orto.example/risk/25>;
        orto:simulationHasWeather   <http://orto.example/weather/17> , <http://orto.example/weather/18> .

<http://orto.example/risk/26>
        a                  orto:CriticalRisk , orto:Risk , orto:RiskAssessment;
        orto:consigli      "Rischio caldo alto: aumentare irrigazione e ombreggiare la pianta.";
        orto:riskCaldo     "HIGH";
        orto:riskFreddo    "LOW";
        orto:riskMalattia  "LOW";
        orto:riskVento     "LOW" .

<http://orto.example/plant/4>
        a                     orto:EarlyGrowthStage , orto:Plant , orto:PlantInstance;
        orto:belongsToGarden  <http://orto.example/garden/2>;
        orto:growthStage      "SEMINA";
        orto:name             "Pomodoro2";
        orto:note             "";
        orto:speciesName      "Pomodoro";
        orto:storeGDD         "0.0"^^<http://www.w3.org/2001/XMLSchema#double> .

<http://orto.example/garden/2>
        a               orto:Garden;
        orto:hasPlant   <http://orto.example/plant/3> , <http://orto.example/plant/4>;
        orto:latitude   "39.1766"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:longitude  "8.9716"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:name       "Orto1" .

orto:LowRisk  <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:Risk .

orto:simulationHasRisk
        <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:SimulationRun;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "simulazione ha rischio"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Risk .

orto:belongsToGarden  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:Plant;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "appartiene all'orto"@it;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:Garden .

orto:longitude  <http://www.w3.org/2000/01/rdf-schema#label>
                "longitudine"@it .

<http://orto.example/weather/17>
        a                    orto:WeatherDay;
        orto:dateTime        "2026-06-28T12:15:30.658425";
        orto:generatesRisk   <http://orto.example/risk/25>;
        orto:precipitazione  "0.0"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:tempMax         "34.4"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:tempMin         "21.9"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:umidita         "55.916666666666664"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:uvIndex         "8.3"^^<http://www.w3.org/2001/XMLSchema#double>;
        orto:windKmh         "16.9"^^<http://www.w3.org/2001/XMLSchema#double> .

orto:influencedBy  <http://www.w3.org/2000/01/rdf-schema#domain>
                orto:Plant;
        <http://www.w3.org/2000/01/rdf-schema#range>
                orto:WeatherDay .

orto:uvIndex  <http://www.w3.org/2000/01/rdf-schema#label>
                "indice UV"@it .

orto:ModerateRisk  <http://www.w3.org/2000/01/rdf-schema#subClassOf>
                orto:Risk .

orto:dateTime  <http://www.w3.org/2000/01/rdf-schema#label>
                "data e ora"@it .
